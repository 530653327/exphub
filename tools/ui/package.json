{
  "name": "exphub-ui",
  "private": true,
  "version": "1.0.0",
  "description": "经验阁移动端样式构建（daisyUI 5 + Tailwind 4）。产物 static/lib/ui/app.css 提交进仓库，运行时不构建。",
  "scripts": {
    "build": "tailwindcss -i input.css -o ../../src/main/resources/static/lib/ui/app.css --minify",
    "watch": "tailwindcss -i input.css -o ../../src/main/resources/static/lib/ui/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "daisyui": "5.8.1",
    "tailwindcss": "4.3.5"
  }
}
